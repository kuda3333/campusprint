# CampusPrint — required environment variables
#
# Copy this file to `.env.local` for `vercel dev`, and run
# `vercel env add <NAME>` for each variable in BOTH Preview and Production
# scopes on Vercel.
#
# The /api/send-email function returns `500 service_unavailable` if any
# Resend variable is missing, and silently skips Supabase JWT verification
# if the Supabase variables are missing.

# ── Resend (transactional email) ────────────────────────────────────────────
# API key scoped to a single verified sending domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender on your Resend domain. MUST NOT be onboarding@resend.dev —
# the handler refuses to send when it sees the sandbox sender.
RESEND_FROM=noreply@mail.campusprint.example.edu

# Where operator notifications go (campus print ops mailbox).
OPERATOR_EMAIL=print-ops@example.edu

# ── CORS allowlist (comma-separated) ───────────────────────────────────────
# The send-email function only accepts cross-origin requests from these
# origins. Fails closed when empty.
ALLOWED_ORIGINS=https://campusprint.vercel.app

# ── Supabase (used for server-side JWT verification) ───────────────────────
# Project URL and anon public key. Same values as in index.html — keeping
# them as env vars lets the function verify caller identity via
# `/auth/v1/user` and lets you point preview deploys at a separate project.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Canonical origin (magic-link redirects + email banner URL) ─────────────
# Must match the production domain exactly — no trailing slash.
# Used by send-email.js to build the email banner <img> src.
CANONICAL_ORIGIN=https://campusprint-pi.vercel.app

# ── Resend webhook (bounce + complaint events) ─────────────────────────────
# Signing secret from Resend dashboard → Webhooks → your endpoint → Secret.
# The /api/webhook-resend handler returns 401 for every request when this
# is missing, so set it before enabling the webhook in Resend.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Sentry (optional — error monitoring) ──────────────────────────────────
# DSN from Sentry → Project Settings → Client Keys.
# When absent, captureException is a no-op. No npm dependency required.
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
