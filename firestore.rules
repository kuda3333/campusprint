rules_version = '2';

// CampusPrint — Firestore security rules
// SAFETY LOCK (2026-05-16): deny all reads/writes until proper auth + per-collection rules ship.
// Council Seat 3 (Security Audit) flagged the default-open posture on Firebase project
// `saloon-booking-ce824` as a live FERPA/GDPR exposure. This file closes the door.
//
// To deploy:  firebase deploy --only firestore:rules  --project <campusprint-prod-project-id>
// Do NOT deploy this against the salon project — that's a separate Firebase project that
// should keep its own rules.
//
// Re-enabling collections after this lock requires:
//   1. Auth integration (Auth.js + Entra ID / Google Workspace / SAML — see SECURITY.md P1)
//   2. Per-collection rule with request.auth.uid + request.auth.token.tenant_id checks
//   3. Schema validation in the rule (no trusting client field types)
//   4. Migration to a dedicated `campusprint-prod` Firebase project (Path B may drop Firebase
//      entirely in favor of Neon Postgres — see SECURITY.md)

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
